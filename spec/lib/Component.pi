from ./Concept import Concept

export abstract anchor Component as component:
    howToBuild:
        A ${self} should be built as a reusable component that will be reused
        throughout the rest of the codebase.  A component is configurable
        through arguments or properties that alter its behaviour, appearance,
        and details.  A ${self} should encapsulate all of its own reusable
        behaviour, while leaving the wiring, intergration, and integration to
        the domain of the application.

    pitch:: string
