use /lib
use /ui
use /ui/components/sidebar/Panel
use /ui/components/sidebar/Sidebar
from /scope/open-file import OpenFileScope
from /scope/project-locations import ProjectLocationsScope
from /scope/prompt-mode/mode-system-prompts import ModeSystemPromptsScope
from /ui/components/scrollbar import ScrollbarScope
from /ui/components/sidebar import SidebarScope

export sidebar RightSidebarScope:
    side: right

    panels:
        - @{ReferencedFilesPanel}
        - @{UnderstandingPanel}

    concept: {RightSidebarConcept}

concept RightSidebarConcept:
    pitch:
        A second @{SidebarScope}, at the right of the message list and the
        chat input beneath it, that lists
        the spec files the running task references, so it's clear what part of
        the spec the harness is working from, and the constraints it has taken
        from it for the task.

    shape: {RightSidebarShape}

shape RightSidebarShape:
    description:
        It runs the full height of the body, beside the body's tab bar, the
        message list or file beneath it, and the chat input beneath those, which stops at its left edge rather than
        running beneath it. It keeps the width it was dragged to while the
        application runs.

        Its two panels, the referenced files above the understanding, sit one
        above the other: the referenced files only as tall as their rows need,
        up to half the sidebar's height, scrolling beyond that, and the
        understanding filling the rest.

    look:
        The sidebar's body is on the ribbon's command area colour, #222222 in
        dark mode. Each panel's header is 32 pixels tall, on the darkest
        surface, #111111 in dark mode, as the file tree is, its title in
        small semibold text, 8 pixels from the left, with no count beside it.
        There is no line anywhere in it, not between a header and its body,
        nor between one panel and the next: the change of colour is the edge.
        The only line is the one down its left edge, where it meets the
        message list and the chat input, which is the handle it is resized
        by. In light mode the
        same steps are taken, as the ribbon's are.

        Neither panel has a permanent scrollbar, since its column would break
        the 8 pixel inset: a panel shows its scrollbar only while its contents
        are taller than it, and none otherwise. When it shows, it is the
        same scrollbar as every other, as the @{ScrollbarScope} says.

        A panel whose contents fit doesn't scroll at all, not even by a
        pixel, at any display scale or window size: it counts as taller than
        its contents need only once they overflow it by a whole pixel or
        more, so what is left over from rounding to the display's pixels
        never counts, and while they fit, it stays scrolled to its top. So
        neither the wheel nor a drag moves rows that all fit, and no
        scrollbar shows for them.

    showing:
        It is only there while a task is running: from the moment a task is
        sent from the Code, Chain, or Spec tab until its run is over. Questions
        from the Ask tab never show it, even when one is sent from the queue.

        When a task starts, it slides out from the right edge of the message
        list and the chat input, growing from nothing to its width, its
        contents sliding into view from behind that edge as it does. When the
        run is over, it slides back the same way. The slide is quick and
        settles without bouncing. The message list and the chat input take
        the rest of the width, laid out anew only once the slide settles.

export panel ReferencedFilesPanel:
    title: Referenced Spec
    counted: false
    height: fit
    scrolls: true
    scrollbar: overflowing

    concept: {ReferencedFilesConcept}

concept ReferencedFilesConcept:
    pitch:
        The top panel of the @{RightSidebarScope}: the spec files the
        running task references.

    shape: {ReferencedFilesShape}

shape ReferencedFilesShape:
    description:
        One row per spec file the running task references, each listed once: first those its prompt imports from, then
        the rest in the order they are first referenced. The rows sit 8
        pixels in from the panel's edges, above and below as well as at the
        sides, each 24 pixels tall, with no icon: each shows its file name
        alone, in small text, without its folders, cut off with
        an ellipsis when the sidebar is too narrow, its full path in its
        tooltip. A file named index, whatever its extension, such as
        `index.pi`, shows the folder it is in before its name, as
        `chat-input/index.pi`, and no folder above that.

    referencing:
        A spec file is one in the spec location, as the
        @{ProjectLocationsScope} says; a compiled spec file is one under
        `.claude/reference`, which stands for part of the spec. Both are
        listed, and files anywhere else are not. A file's full path counts
        however long it is, and a relative path is read from the project
        directory.

        A file is referenced, however the harness reads it, when:

        - the task's prompt imports from it, its hidden anchor naming it
        - the harness reads, edits, or writes it with a file tool
        - a shell command reads it, such as cat, head, tail, sed, less, grep,
            rg, awk, or diff naming it, or a pattern or folder that takes it in,
            as far as the command shows
        - a shell command edits or writes it, such as sed -i, a redirect (> or
            >>), tee, mv, or cp onto it
        - a search tool, Grep or Glob, searches a folder or pattern that takes
            it in and its results name it
        - a subagent the harness starts does any of the above

        A file taken in only by a folder or pattern, without the results
        naming it, is not listed. A command whose target can't be worked out
        is skipped rather than guessed at. A file referenced again isn't listed
        again.

        A file edited or written in any of these ways, rather than only read
        or imported, shows a small pencil icon at the right of its row. A row
        a subagent referenced shows the same way, with "Read by a subagent" in
        its tooltip beneath its full path.

        Clicking a row opens its file, as the @{OpenFileScope} says. While no
        spec file is referenced yet, the list reads
        "No spec files referenced yet", muted.

export panel UnderstandingPanel:
    title: Understanding
    counted: false
    height: fill
    scrolls: true
    scrollbar: overflowing

    concept: {UnderstandingConcept}

concept UnderstandingConcept:
    pitch:
        The bottom panel of the @{RightSidebarScope}: the constraints
        the harness has taken from the spec for the running task.

    shape: {UnderstandingShape}

shape UnderstandingShape:
    description:
        It shows the running task's understanding file, as the
        @{ModeSystemPromptsScope} says, as it is written: one row per item of
        its Markdown list, in the file's order, its text wrapping rather than
        cut off. Each row is a box on the ribbon's tab row colour, #333333 in
        dark mode, with corners rounded 4 pixels, its text in small text with
        a 20 pixel line height, 8 pixels of padding either side and 6 above
        and below, so it is 32 pixels tall for a single line;
        the boxes sit 8 pixels in from the panel's edges and 4 pixels apart. Anything in the file that isn't a list item is left out.

        A row's text is its item's, with any link shown as its text alone.
        Clicking a row opens the file its link points to, read from the
        project directory, as the @{OpenFileScope} says. A row whose link
        points to a file that doesn't exist shows its text muted, and clicking
        it does nothing; a row with no link does nothing either.

        It follows the file as it changes on disk while the task runs. A row
        that is added, or whose text changes, is briefly highlighted, fading
        back to its box's colour. Until the file exists, it reads
        "Nothing understood yet", muted. Once it exists but has no list items
        yet, as when it has just been created, the panel shows nothing beneath
        its header, and has nothing to scroll and no scrollbar.
