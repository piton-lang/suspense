use /lib
from /ui import UiComponent

// A panel in a sidebar. What it is like follows from its properties, each
// switching the text of the panel section as the panel is extended.
export abstract anchor Panel extends UiComponent as panel:
    // Its header's title, or none for a panel with no header.
    title:: null:: string: null
    // Whether its header counts what it lists.
    counted:: boolean: false
    // How it takes its height: fill, fit, or share.
    height:: string: fill
    // Whether its contents scroll within it.
    scrolls:: boolean: true

    panel:
        ${self.title ? "It has a header along its top, reading its title in small, semibold text, with a little padding around it. The header is on the theme's raised surface and the panel's body on its base surface, so the header stands slightly apart from the body, contrasting with it only a little, with no line between them." : "It has no header: its contents start at its top edge, on the theme's base surface."}

        ${self.counted ? "At its header's right, how many rows it lists, in smaller text, muted." : "It shows no count of what it lists."}

        ${self.height == "share" ? "It shares the height its sidebar's other panels leave with the other panels that share it, one above the other, split by a line that can be dragged to change their shares, each at least 80 pixels tall. They start with equal shares." : self.height == "fit" ? "It is only as tall as its contents need, taking no more of its sidebar's height." : "It fills the height its sidebar's other panels leave."}

        ${self.scrolls ? "Its contents scroll on their own when they are taller than it, with a permanent scrollbar along its right, as the ScrollbarScope says." : "Its contents never scroll: it is as tall as they are."}
