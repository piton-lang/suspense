use /lib
use /ui
from /scope/editor import EditorScope
from /scope/git import GitScope
from /scope/open-file import OpenFileScope
from /scope/user-preferences import UserPreferencesScope
from /ui/components/scrollbar import ScrollbarScope

export ui-component DiffViewScope:
    pitch: {DiffViewConcept.pitch}
    shape: {DiffViewConcept.shape}

concept DiffViewConcept:
    pitch:
        A view of one file's uncommitted changes: the file as of the last
        commit, from the @{GitScope}, against the file as it is on disk.

    shape: {DiffViewShape}

shape DiffViewShape:
    description:
        A header along the top, and beneath it the changes, which scroll with
        a @{ScrollbarScope}. It fills whatever holds it, and follows the
        file as it changes on disk.

    snapshots:
        It can also show one file's changes between two snapshots of the
        working tree, as a task's changed files are opened. Then its left side
        is the file in the earlier snapshot and its right the file in the
        later, both read from git's trees, not from disk, so it doesn't follow
        the file as it changes on disk. A file added has nothing on its left,
        and a file deleted nothing on its right. A renamed file shows its old
        path's contents against its new path's. Its header reads the same, and
        its button that opens the file opens it as it is on disk now.

    header:
        The file's path in the project, beside a diff icon, and how many lines
        were added (+, in green) and removed (−, in red). At the right end:
        buttons to step to the previous and next change; a switch between
        "Side by side" and "Unified", each with an icon, the chosen one shown
        selected; a button that opens the file instead, as the
        @{OpenFileScope} says; and a
        close button.

    layouts:
        sideBySide:
            The file as of the last commit on the left and as it is now on the
            right, divided by a thin line. A removed line faces the added line
            that replaced it, and a line with no counterpart faces blank,
            shaded filler, so the two sides stay level. Each side has its own
            line numbers.

        unified:
            One column, with each block of removed lines before the added
            lines that replaced them. Each line shows both line numbers: its
            number in the old file and in the new, either blank where the line
            isn't in that version.

        The chosen layout is one of the @{UserPreferencesScope}, starting side
        by side.

    lines:
        Lines are shown in the editor's monospace font, one row each, without
        wrapping, tabs shown as four spaces. An added line is tinted green and
        marked +, a removed line tinted red and marked −, so a change never
        relies on colour alone; unchanged lines are neither. Within a line
        that replaced, or was replaced by, a similar one, the words that
        changed get a stronger tint of the same colour. A line changed through
        and through isn't marked word by word.

    unchangedLines:
        Three unchanged lines are kept either side of each change. A longer run
        of unchanged lines, four or more, collapses into a single shaded row
        reading "Show N unchanged lines", which expands them when clicked. A
        file with no changes is shown whole.

    navigating:
        F7 steps to the next change and Shift+F7 to the previous one, stopping
        at the first and last, as do the header's buttons. The change stepped
        to is scrolled to the middle of the view and marked with an accent bar
        along its left.

    states:
        While the file is read it says "Loading…". A binary file says its
        changes can't be shown. An empty file says so. A file that can't be
        read says why.

    merging:
        It can also merge two versions of a file being edited, as the
        @{EditorScope} opens it when the file changed on disk while it had
        unsaved changes. Then its left side is the file as it now is on disk,
        headed "On disk", and its right side the editor's unsaved text, headed
        "Mine", in either layout, so it shows the changes that would turn what
        is on disk into the editor's text. It follows the file on disk as it
        changes, keeping each change's choice where the change is still there.


        choosing:
            Each change has two small buttons beside it, at its top: "Use
            Disk", which takes the lines on disk for that change, and "Use
            Mine", which keeps the editor's lines, the chosen one shown
            selected. Every change starts on "Use Mine". The merged text is
            the editor's text with each change set to "Use Disk" put back to
            the lines on disk. A change set to "Use Disk" is shown dimmed on
            the "Mine" side, its lines struck through, and a change keeping
            "Use Mine" dimmed on the "On disk" side, so what the merge keeps
            is always the side shown plain. Its header's counts and stepping
            between changes work as ever.

        header:
            Its header reads the same, but in place of the button that opens
            the file and the close button, it has "Use All Disk" and "Use All
            Mine", which set every change at once, then "Cancel", and "Apply
            Merge" as the primary button, which hands the merged text to the
            editor. <Escape> is "Cancel".
