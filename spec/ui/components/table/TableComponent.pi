use /lib
use /ui
from ./CollapsedRows import TableCollapsedRows
from ./Drawing import TableDrawing
from ./Header import TableHeader
from ./Measuring import TableMeasuring
from ./Scrolling import TableScrolling
from /ui/components/file-tree import FileTree

export ui-component Table:
    pitch:
        A table of rows under a header of named columns, that can grow long
        and keep growing while it is shown, and stays smooth however long it
        gets.

    description:
        A header row naming each column, above one row per item, in order.
        Every table is a table, as its own scope says: it names its columns,
        whether it has the lock to the bottom, and what rows it can collapse,
        and those decide how it is drawn. Each use says what each row holds
        and where it sits.

    header: {TableHeader}
    scrolling: {TableScrolling}
    drawing: {TableDrawing}
    measuring: {TableMeasuring}
    collapsedRows: {TableCollapsedRows}

    background:
        The table's rows sit on the same darkest surface as the
        @{FileTree}, #111111 in dark mode and #e1e1e1 in light mode,
        moving with it as the theme's brightness changes, wherever the table is
        used. Only the header keeps its own raised look above them.

    legibility:
        The table should be readable at a glance. Make sure the font size is
        large enough, and that the colours are legible in both light and dark
        mode.

