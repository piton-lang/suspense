use /lib
from /ui/components/scrollbar import Scrollbar

export anchor TableScrolling:
    description:
        The rows scroll beneath the table's header with a @{Scrollbar},
        with or without its lock to the bottom. Locked, the table follows its
        latest rows. Unlocked, it still follows new rows while it is already
        scrolled to the bottom, and stays put once scrolled away from it.
