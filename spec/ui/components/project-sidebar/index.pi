use /lib
use /ui/components/sidebar/Sidebar
from /scope/application/Body import BodyScope
from /ui/components/file-tree import FileTreeScope
from /ui/components/git-panel import GitPanelScope
from /ui/components/right-sidebar import RightSidebarScope
from /ui/components/sidebar import SidebarScope

export sidebar ProjectSidebarScope:
    side: left

    panels:
        - @{FileTreeScope}
        - @{GitPanelScope}

    concept: {ProjectSidebarConcept}

concept ProjectSidebarConcept:
    pitch:
        The @{SidebarScope} along the left of the main window, beside the
        @{BodyScope}, holding the tools for finding your way around the
        project.

    shape: {ProjectSidebarShape}

shape ProjectSidebarShape:
    description:
        Runs the full height of the window beneath the ribbon, to the left of
        the body, and the chat input along its bottom. The file tree fills it from
        the top, and the git panel sits along the bottom, underneath it,
        taking only the height it needs, up to half the sidebar, or up to
        where the edge between them has been dragged, as the @{GitPanelScope}
        says.

    others:
        It is the only sidebar on the body's left. While a task runs, a second
        one, the running task's referenced spec, slides out at the right of
        the message list and the chat input, as the
        @{RightSidebarScope} says.
