use /lib
use /ui

export ui-component RibbonResearchTabScope:
    concept: {RibbonResearchTabConcept}

concept RibbonResearchTabConcept:
    pitch:
        The ribbon's Research tab: the commands for researching before building.

    shape: {RibbonResearchTabShape}

shape RibbonResearchTabShape:
