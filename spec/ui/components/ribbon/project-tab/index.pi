use /lib
use /ui
from /scope/import-project import ImportProject
from /scope/new-project import NewProject
from /scope/project-directory import ProjectDirectory
from /scope/project/open-project import OpenProject
from /ui/components/project-indicator import ProjectIndicator

export ui-component RibbonProjectTab:
    pitch:
        The ribbon's Project tab: the commands for the project as a whole.

    description:
        The Project tab of the ribbon, first of the tabs and the one the window
        opens on.

    groups:
        project:
            A "Project" group holds the New Project command, then the Import
            Project command, then the Open Project command, all slim, stacked
            in that order with New Project on top.

    commands:
        newProject:
            A "New Project" button with a folder-plus icon. Clicking it opens
            the @{NewProject}, and its tooltip says it creates a new
            project and opens it.

            It is primary, and a slim button.

        importProject:
            An "Import Project…" button with a folder-input icon. Clicking it
            opens the @{ImportProject}, and its tooltip says it makes an
            existing folder into a project and opens it.

            It is primary, and a slim button.

        openProject:
            A button with a folder icon that always reads "Open Project…",
            whether or not a project is open; the @{ProjectIndicator} beside
            the ribbon's tabs shows which is. Its tooltip says to pick a
            piton.config.pi file, whose folder becomes the project.

            Clicking it opens the @{OpenProject}.

            It is primary, and a slim button.

