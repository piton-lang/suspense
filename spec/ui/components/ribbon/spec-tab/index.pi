use /lib
from /scope/rescope import RescopeScope
from /scope/generate-skills import GenerateSkillsScope
from /scope/divergence import DivergenceScope
from /scope/no-project import NoProjectStateScope
from /scope/spec-build import SpecBuildScope
from /ui/components/minimizable-panel import MinimizablePanelScope

export scope RibbonSpecTabScope:
    concept: {RibbonSpecTabConcept}

concept RibbonSpecTabConcept:
    pitch:
        The ribbon's Spec tab: the commands for working on the spec.

    shape: {RibbonSpecTabShape}

shape RibbonSpecTabShape:
    description:
        The Spec tab of the ribbon.

    groups:
        build:
            A "Build" group holds the Build Spec command.

        analysis:
            An "Analysis" group, after Build, holds the Analyze Divergence
            command, then the View Divergence Reports command.

        skills:
            A "Skills" group, after Analysis, holds the Generate Skills command.

        refactor:
            A "Refactor" group, after Skills, holds the Rescope command.

    commands:
        noProject:
            Every command on the tab needs a project, so until one is open, each
            is disabled as the @{NoProjectStateScope} says, with the tooltip
            each gives.

        rescope:
            A "Rescope" button with a shapes icon. Clicking it opens the
            @{RescopeScope} and starts looking for repeated concepts, or brings
            back a minimized one, as a @{MinimizablePanelScope} does, and its
            tooltip says it finds concepts the spec repeats that could be scopes
            of their own. Without a project, its tooltip says to open a project
            to rescope its spec.

            It isn't primary.

        generateSkills:
            A "Generate Skills" button with a sparkles icon. Clicking it opens
            the @{GenerateSkillsScope} and starts ranking the spec's scopes for
            skills, and its tooltip says it finds which scopes skills should be
            built for. Without a project, its tooltip says to open a project to
            generate skills for it.

            It isn't primary.

        analyzeDivergence:
            An "Analyze Divergence" button with a compare-arrows icon. Clicking
            it opens the @{DivergenceScope} and starts a fresh analysis, and its
            tooltip says it analyzes how the code and the spec have diverged.
            Without a project, its tooltip says to open a project to analyze
            it.

            It is primary.

        viewDivergenceReports:
            A "View Divergence Reports" button with a document icon. Clicking
            it opens the @{DivergenceScope} without starting an analysis,
            showing the latest saved report, from which the earlier ones can be
            opened, and its tooltip says it shows the reports of earlier
            analyses. Without a project, its tooltip says to open a project to
            view its reports.

            It isn't primary.

        buildSpec:
            A "Build Spec" button with a hammer icon. Clicking it builds the
            spec on its own, as the @{SpecBuildScope} says, and its tooltip says
            it runs `piton build` in the project to compile the spec. Without a
            project, its tooltip says to open a project to build its spec.

            It is primary.
