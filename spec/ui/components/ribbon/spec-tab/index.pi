use /lib
from /scope/divergence import DivergenceScope

export scope RibbonSpecTabScope:
    concept: {RibbonSpecTabConcept}

concept RibbonSpecTabConcept:
    pitch:
        The ribbon's Spec tab: the commands for working on the spec.

    shape: {RibbonSpecTabShape}

shape RibbonSpecTabShape:
    description:
        The Spec tab of the ribbon.

    groups:
        build:
            A "Build" group holds the Build Spec command.

        analysis:
            An "Analysis" group, after Build, holds the Analyze Divergence
            command, then the View Divergence Reports command.

    commands:
        analyzeDivergence:
            An "Analyze Divergence" button with a compare-arrows icon. Clicking
            it opens the @{DivergenceScope} and starts a fresh analysis, and its
            tooltip says it analyzes how the code and the spec have diverged. It
            is disabled until a project is open, with a tooltip saying to open a
            project to analyze it.

            It is primary.

        viewDivergenceReports:
            A "View Divergence Reports" button with a document icon. Clicking
            it opens the @{DivergenceScope} without starting an analysis,
            showing the latest saved report, from which the earlier ones can be
            opened, and its tooltip says it shows the reports of earlier
            analyses. It is disabled until a project is open, with a tooltip
            saying to open a project to view its reports.

            It isn't primary.

        buildSpec:
            A "Build Spec" button with a hammer icon. Clicking it runs
            `piton build` in the project, to compile the spec, and its tooltip
            says so.

            It is disabled until a project is open, with a tooltip saying to
            open a project to build its spec, and while the spec is building,
            when it shows a spinner and its tooltip says the spec is building.

            When the build is over, a notification says how it went. A build
            that succeeds is titled "Built 1 file" or "Built N files", and lists
            each file written on a line of its own, never wrapped. A build that
            fails is titled "Build failed", with what the build reported. When
            `piton build` can't be run at all, the notification is titled
            "Could not run piton build", with why.

            It is primary.
