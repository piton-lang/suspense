use /lib
from /ui/components/fs-browser import FsBrowserScope, FsBrowserConcept, FsBrowserShape

export scope FolderBrowserScope extends FsBrowserScope:
    concept: {FolderBrowserConcept}

concept FolderBrowserConcept extends FsBrowserConcept:
    pitch:
        An @{FsBrowserScope} for choosing a folder.

    shape: {FolderBrowserShape}

shape FolderBrowserShape extends FsBrowserShape:
    listed:
        Only the current folder's folders are listed, never its files. A folder
        with no folders in it reads "No folders here". Clicking a folder twice,
        or <Enter> or <Right> with it selected, goes into it.

    chosen:
        What will be chosen, shown in the footer, is the selected folder, or
        the current folder when none is selected, so Choose is never disabled
        and its tooltip says it chooses this folder. <Enter> with no folder
        selected chooses the current folder. A folder just created is selected,
        so pressing Choose chooses it straight away.
