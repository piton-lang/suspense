use /lib
use /ui/components/table/Table
from ./CollapsedSteps import TaskTableCollapsedSteps
from ./Notices import TaskTableNotices
from ./Outcome import TaskTableOutcome
from ./Replies import TaskTableReplies
from ./Scrolling import TaskTableScrolling
from ./Sent import TaskTableSent
from ./Status import TaskTableStatus
from ./Streaming import TaskTableStreaming
from ./ToolCalls import TaskTableToolCalls
from ./Types import TaskTableTypes
from /ui/components/table import Table

export table TaskTable:
    columns: Type, Output, and Status
    collapses: step

    pitch:
        The output of one run of the harness, as a table of everything it did,
        filling in as it does it.

    description:
        A @{Table} with Type, Output, and Status columns, with one row per
        thing the harness did, in order: each piece of reply text, each tool
        call, and any error. It is the same table wherever a run's output is
        shown, a task, a previous task, the palette's search for a file, or a
        run in one of the application's own panels, and each use says where
        it sits. The answers to questions are the exception: they read as
        chat replies, as the Ask conversation says.

    types: {TaskTableTypes}
    status: {TaskTableStatus}
    replies: {TaskTableReplies}
    outcome: {TaskTableOutcome}
    toolCalls: {TaskTableToolCalls}
    streaming: {TaskTableStreaming}
    scrolling: {TaskTableScrolling}
    collapsedSteps: {TaskTableCollapsedSteps}
    sent: {TaskTableSent}
    notices: {TaskTableNotices}

    legibility:
        The output from a realtime agent should be readable and meaningful.

    narrowWidths:
        However narrow the table is drawn, the Output column keeps most of its
        width. The Type and Status columns are no wider than their widest label
        needs, and the space inside the cells and around the table tightens as
        the table narrows, so the output is never squeezed into a sliver
        between padding and empty space.

