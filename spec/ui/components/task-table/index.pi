use /lib
use /ui/components/table/Table
from /ui/components/table import TableScope
from ./Types import TaskTableTypesShape
from ./Status import TaskTableStatusShape
from ./Replies import TaskTableRepliesShape
from ./ToolCalls import TaskTableToolCallsShape
from ./Streaming import TaskTableStreamingShape
from ./Scrolling import TaskTableScrollingShape
from ./CollapsedSteps import TaskTableCollapsedStepsShape

export table TaskTableScope:
    columns: Type, Output, and Status
    collapses: step

    concept: {TaskTableConcept}

concept TaskTableConcept:
    pitch:
        The output of one run of the harness, as a table of everything it did,
        filling in as it does it.

    shape: {TaskTableShape}

shape TaskTableShape:
    description:
        A @{TableScope} with Type, Output, and Status columns, with one row per
        thing the harness did, in order: each piece of reply text, each tool
        call, and any error. It is the same table wherever a run's output is
        shown, a task, a question, a previous task or answer, the palette's
        search for a file, or a run in one of the application's own panels,
        and each use says where it sits.

    types: {TaskTableTypesShape}
    status: {TaskTableStatusShape}
    replies: {TaskTableRepliesShape}
    toolCalls: {TaskTableToolCallsShape}
    streaming: {TaskTableStreamingShape}
    scrolling: {TaskTableScrollingShape}
    collapsedSteps: {TaskTableCollapsedStepsShape}

    legibility:
        The output from a realtime agent should be readable and meaningful.
