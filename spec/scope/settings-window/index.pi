use /lib
use /ui
from ../project-directory import ProjectDirectoryScope
from ../prompt-mode/chat-input import ChatInputScope
from ../no-project import NoProjectStateScope
from ../project-data import ProjectDataScope
from ../prompt-mode/mode-system-prompts import ModeSystemPromptsScope
from ../prompt-mode/modes import PromptModesScope
from /ui/components/inset-panel import InsetPanelScope
from /ui/components/scrollbar import ScrollbarScope

export ui-component SettingsWindowScope:
    concept: {SettingsWindowConcept}

concept SettingsWindowConcept:
    pitch:
        The application's settings, which for now are
        the system prompts each tab of the @{ChatInputScope} sends.

    shape: {SettingsWindowShape}

shape SettingsWindowShape:
    description:
        Shown in an @{InsetPanelScope} over the main window, not a window of its
        own. It is headed "Settings", with a close button whose tooltip says it
        closes the settings; closing the panel any way an inset panel closes
        closes them too. Beneath the heading, its page scrolls with a
        @{ScrollbarScope}.

    opening:
        It opens with Ctrl+, (Cmd+, on macOS) from anywhere in the application,
        or from whatever command opens the settings, in place of anything else
        in the inset panel. Opening it while it is already open leaves it as it
        is rather than opening another.

    systemPrompts:
        The page is headed "System prompts", with a muted line beneath saying
        that each tab gives a prompt sent from it this system prompt, that they
        are saved with the project as they are edited, and that the
        CODE_LOCATION and SPEC_LOCATION placeholders stand for the code and spec
        locations, as the @{ModeSystemPromptsScope} says.

        Then, for each tab, in the order of the @{PromptModesScope}: its name,
        the muted path of the file its prompt is saved in, and a
        "Reset to default" button, disabled while the prompt is already the
        default, which puts the default back and saves it. Beneath them, an
        editor for the prompt, 120 pixels tall before it scrolls, highlighting
        it as Piton, with soft wrapping and no line numbers or folding. A prompt
        that can't be read or saved says why beneath its editor.

        Without a project open, as the @{NoProjectStateScope} says, in place of
        the prompts it reads "Open a project to edit its system prompts."

    saving:
        The prompts belong to the project opened through the
        @{ProjectDirectoryScope}, each saved with the project's data, as the
        @{ProjectDataScope} says. Every edit is saved straight away. When the
        window loads the prompts, any tab with no file yet has its default
        saved, so every prompt can also be found and
        edited by hand. The prompts are read again each time the settings open
        and whenever another project is opened, so an edit made by hand shows
        up; a prompt that already shows what was read is left alone, so its
        cursor stays put.

    templates:
        A prompt is a template, as the @{ModeSystemPromptsScope} says, and a
        reset puts back its default.
