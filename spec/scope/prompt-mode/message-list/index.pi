use /lib
use /ui
from ./Backgrounds import MessageListBackgrounds
from ./ChangedFiles import MessageListChangedFiles
from ./Freeform import MessageListFreeform
from ./Links import MessageListLinks
from ./OutputTable import MessageListOutputTable
from ./ReferencedSpec import MessageListReferencedSpec
from ./RunningTasks import MessageListRunningTasks
from ./Scrolling import MessageListScrolling
from ./SentPrompt import MessageListSentPrompt
from ./Status import MessageListStatus

export ui-component MessageList:
    pitch:
        The task view of prompt mode: the tasks sent to the harness and their
        output as the harness works on them.

    description:
        Shows tasks and their output, not a conversation. Prompts aren't shown
        on the right with responses on the left, and tool calls aren't gathered
        into groups. Freeform is the exception: a Freeform task is shown as a
        regular chat, as its freeform says.

    sentPrompt: {MessageListSentPrompt}
    status: {MessageListStatus}
    runningTasks: {MessageListRunningTasks}
    outputTable: {MessageListOutputTable}
    links: {MessageListLinks}
    backgrounds: {MessageListBackgrounds}
    referencedSpec: {MessageListReferencedSpec}
    scrolling: {MessageListScrolling}
    changedFiles: {MessageListChangedFiles}
    freeform: {MessageListFreeform}

