use /lib
use /ui
from ./Backgrounds import MessageListBackgroundsShape
from ./ChangedFiles import MessageListChangedFilesShape
from ./Links import MessageListLinksShape
from ./OutputTable import MessageListOutputTableShape
from ./ReferencedSpec import MessageListReferencedSpecShape
from ./Scrolling import MessageListScrollingShape
from ./SentPrompt import MessageListSentPromptShape
from ./Status import MessageListStatusShape

export ui-component MessageList:
    concept: {MessageListConcept}

concept MessageListConcept:
    pitch:
        The task view of prompt mode: the tasks sent to the harness and their
        output as the harness works on them.

    shape: {MessageListShape}

shape MessageListShape:
    description:
        Shows tasks and their output, not a conversation. Prompts aren't shown
        on the right with responses on the left, and tool calls aren't gathered
        into groups.

    sentPrompt: {MessageListSentPromptShape}
    status: {MessageListStatusShape}
    outputTable: {MessageListOutputTableShape}
    links: {MessageListLinksShape}
    backgrounds: {MessageListBackgroundsShape}
    referencedSpec: {MessageListReferencedSpecShape}
    scrolling: {MessageListScrollingShape}
    changedFiles: {MessageListChangedFilesShape}
