use /lib
use /ui
from ../editor import EditorScope
from ../no-project import NoProjectStateScope
from ../open-file import OpenFileScope
from ../prompt-mode import PromptEditor
from ../prompt-mode/chat-input import ChatInputScope
from ../prompt-mode/message-list import MessageList
from /ui/components/file-tree import FileTreeScope
from /ui/components/inset-panel import InsetPanelScope
from /ui/components/project-sidebar import ProjectSidebarScope
from /ui/components/referenced-spec-sidebar import ReferencedSpecSidebarScope
from /ui/components/ribbon import RibbonScope

export ui-component BodyScope:
    concept: {BodyConcept}

concept BodyConcept:
    pitch:
        The main window's body: the area to the right of the project sidebar,
        where the tasks sent to the harness, and any file opened beside them,
        are shown, and the chat input they are sent from.

    shape: {BodyShape}

shape BodyShape:
    description:
        Beneath the @{RibbonScope}, to the right of the
        @{ProjectSidebarScope}, which runs the full height beside it, and
        reaching the window's right edge. It is part of the @{PromptEditor}.

        The @{ChatInputScope} lives within the body, along its bottom, across
        its full width: its left edge against the project sidebar, and its
        right edge at the window's. Above it, the message list, with, while a
        task runs, the @{ReferencedSpecSidebarScope} at its right; the chat
        input runs beneath both, the right sidebar never reaching down beside
        it.

    contents:
        Everything that can be in the body:

        - the @{MessageList}, the chat history, which fills the space above the chat input whenever no file is open
        - the hint shown in the message list's place before any task has been sent, or while no project is open, as the @{PromptEditor} and the @{NoProjectStateScope} say
        - an @{EditorScope}, in a split beside the message list, while a file is open
        - the @{ReferencedSpecSidebarScope}, at the message list's right while a task runs
        - the @{ChatInputScope}, along the bottom beneath all of these

        An @{InsetPanelScope} floats over the whole window, the body included,
        but is never part of it.

    openFile:
        A file opened, from the @{FileTreeScope} or anywhere else the
        @{OpenFileScope} says, shows in an @{EditorScope}, in a split beside
        the chat history: the file on the left taking 50%
        of the width, the chat history on the right taking the rest. The
        split can be resized by dragging its edge. Closing the file closes
        the split.

        When the split opens, it slides in from the sidebar, so it's clear
        where it came from: the file's side grows out of the sidebar's edge
        to its share of the width, the file sliding into view from behind
        that edge as it does, over the chat history. The chat history keeps
        its width while the file slides over it, so nothing in it is laid
        out anew each frame, and takes the rest of the width once the slide
        settles.

        The slide is quick and settles without bouncing, and only then can
        the split be dragged. A file opened in place of one already showing
        doesn't slide, since the split is already open. The
        @{ChatInputScope} is never split: it stays along the bottom, across
        the full width of prompt mode.

        Closing the file plays the slide in reverse, back into the
        sidebar: the file's side shrinks from whatever width it was
        dragged to down to nothing at the sidebar's edge, the file sliding
        out of view behind that edge as it does, uncovering the chat
        history, which is back across the full width beneath it from the
        start of the slide. It is as quick as the slide in,
        and settles without bouncing. Opening a file while one is still
        sliding out slides the new one in straight away.
