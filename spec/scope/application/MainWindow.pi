use /lib
use /ui
from ../divergence import DivergenceScope
from ../editor import EditorScope
from ../harness-integration/catalog import HarnessCatalogScope
from ../new-project import NewProjectScope
from ../open-file import OpenFileScope
from ../palette import PaletteScope
from ../project/open-project import OpenProjectScope
from ../prompt-mode import PromptEditor
from ../prompt-mode/chat-input import ChatInputScope
from ../prompt-mode/sending import PromptSendingScope
from ../rescope import RescopeScope
from ../run-targets import RunTargetsScope
from ../running-activity import RunningActivityScope
from ../settings-window import SettingsWindowScope
from ../user-preferences import UserPreferencesScope
from ./Body import BodyScope
from /ui/components/diff-view import DiffViewScope
from /ui/components/file-tree import FileTreeScope
from /ui/components/inset-panel import InsetPanelScope
from /ui/components/minimizable-panel import MinimizablePanelScope
from /ui/components/project-sidebar import ProjectSidebarScope
from /ui/components/ribbon import RibbonScope
from /ui/theme import ThemeScope

export ui-component MainWindowScope:
    concept: {MainWindowConcept}

concept MainWindowConcept:
    pitch:
        The main window of the application allowing you interact with all main
        functionality.

    shape: {MainWindowShape}

shape MainWindowShape:
    description:
        Maximized window.

    darkMode:
        The whole window, including popups and notifications, is drawn in the
        @{ThemeScope}, in its dark or its light mode.

        The Brightness slider in the ribbon's Application tab runs through
        both, and the palette's "Dark mode" or "Light mode" toggles between
        them.

        The choice is one of the @{UserPreferencesScope}, so until a choice has
        been made, the window follows the operating system's light or dark
        appearance.

    escape:
        Pressing Esc closes whatever it dismisses, such as a completion menu, a
        popup, the palette, or an inset panel, and otherwise does what it does
        where the keyboard is. It never moves focus to the @{ChatInputScope}.

    focusingTheChat:
        Pressing <Ctrl+Enter> (<Cmd+Enter> on macOS) while the
        @{ChatInputScope} doesn't have the keyboard, such as in an
        @{EditorScope}, the @{FileTreeScope}, or the Git panel, moves focus to it,
        with its cursor where it was, and sends nothing. While it has the
        keyboard, it sends as the chat input says. Wherever else it already
        means something, it keeps that meaning: in the palette, in a dialog,
        in the list of recent projects, and in an inset panel, which the chat
        input is beneath.

    pointer:
        Where the hit areas of two things that take a press overlap, such as
        the edge a sidebar, split, or drawer is resized by and the scrollbar of
        the list beside it, a press goes to the one with the smaller hit area,
        and only to it: a scrollbar's button, or its thumb, takes a press over
        the wider strip of a resize edge, while the edge takes one over the
        scrollbar's track when the edge is the smaller. The cursor shows what a
        press there would do.

        A resize and a scroll are never under way at the same time. While an
        edge is being dragged, the mouse wheel scrolls nothing, and while a
        scrollbar's thumb is being dragged, no edge can be picked up, however
        the pointer crosses one. Nothing shows as hovered while something is
        being dragged, either: an edge dragged across a scrollbar lights up
        none of its buttons or its thumb, and shows no tooltip.

    quitting:
        The application quits with Ctrl+Q (Cmd+Q on macOS), Quit in the
        @{PaletteScope}, or the window's close button. Any of them asks first
        while work is running, as the @{RunningActivityScope} says.

    palette:
        Ctrl+P (Cmd+P on macOS) opens the @{PaletteScope} over the window, for
        fuzzy searching the project's files, the application's own commands, and
        the commands, skills, and agents of the @{HarnessCatalogScope}.

    header:
        ribbon: @{RibbonScope}

    layout:
        sidebar: @{ProjectSidebarScope}

        body: @{BodyScope}

        openDiff:
            A file's @{DiffViewScope}, opened from the @{FileTreeScope}, opens
            in an @{InsetPanelScope}. It leaves the body's tabs alone: every
            file open in them stays open, unsaved changes and all. Opening another file's
            diff replaces the one in the panel, as does opening one while a new
            project is being set up. Opening the file from the diff closes the
            panel and opens the file, as the @{OpenFileScope} says.

        analyzeDivergence:
            The ribbon's Analyze Divergence command opens the @{DivergenceScope}
            as a @{MinimizablePanelScope}, to analyze, in place of whatever else
            is open there, or brings back one that was minimized.

        rescope:
            The ribbon's Rescope command opens the @{RescopeScope} as a
            @{MinimizablePanelScope}, in place of whatever else is open there,
            or brings back one that was minimized. Its Refactor sends its prompt
            to the prompt mode on the application's behalf, as the
            @{PromptSendingScope} says.

        run:
            The Code tab's run commands open the @{RunTargetsScope}'s panel as a
            @{MinimizablePanelScope}, in place of whatever else is open there,
            or bring back one that was minimized, as it says.

        viewDivergenceReports:
            The ribbon's View Divergence Reports command opens the
            @{DivergenceScope} the same way, to view the reports, without
            starting an analysis.

        newProject:
            The ribbon's New Project command opens the @{NewProjectScope} in an
            @{InsetPanelScope}, fresh each time, in place of any diff open
            there. Once the project is created, the panel closes and the new
            project is open.

        openProject:
            The Open Project commands, from the ribbon or the palette, show the
            @{OpenProjectScope} in an @{InsetPanelScope}, in place of whatever
            else is open there.

        settings:
            The settings, opened with Ctrl+, (Cmd+, on macOS), the ribbon's
            Settings command, or the palette, show the @{SettingsWindowScope}
            in an @{InsetPanelScope}, in place of whatever else is open there.

        promptMode:
            The @{PromptEditor} fills the rest of the window, to the right of
            the @{ProjectSidebarScope}: the @{BodyScope}, with the chat input
            along its bottom, within it.
