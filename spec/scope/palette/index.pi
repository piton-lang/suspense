use /lib
use /ui
from /scope/planning import Planning
from /scope/about import About
from /scope/debug-log import DebugLog
from /scope/harness-integration/baked-prompts import BakedSystemPrompts
from /scope/harness-integration/catalog import HarnessCatalog
from /scope/import-project import ImportProject
from /scope/new-project import NewProject
from /scope/no-project import NoProjectState
from /scope/open-file import OpenFile
from /scope/project-directory import ProjectDirectory
from /scope/project-locations import ProjectLocations
from /scope/project/open-project import OpenProject
from /scope/prompt-mode/chat-input import ChatInput
from /scope/settings-window import SettingsWindow
from /scope/spec-build import SpecBuild
from /ui/components/scrollbar import Scrollbar
from /ui/components/task-table import TaskTable

export ui-component Palette:
    pitch:
        A popover for finding anything in the application by fuzzy searching
        for it: the project's files, the application's own commands, and the
        harness's commands, skills, and agents.

    description:
        A popover near the top of the window, over a dimmed backdrop: a tab bar
        using gpui-kit's default tab styling, a search field beneath it, and the
        results beneath that.

    opening:
        Ctrl+P (Cmd+P on macOS) anywhere in the window opens the palette on the
        Files tab with an empty search and focus in the search field. Pressing
        it again while the palette is open closes it.

    closing:
        Picking a result closes the palette. Esc clears the search, and closes
        the palette once the search is empty. Clicking outside the palette
        closes it. Closing it without picking anything puts focus back where it
        was.

    tabs:
        overview:
            The tabs are Files, System, Commands, Skills, and Agents, in that
            order. Each lists its own results. The search is kept when switching
            tabs, and applies to the tab switched to.

        switching:
            Clicking a tab switches to it. <Tab> moves to the next tab and
            <Shift+Tab> to the previous one, wrapping around, and focus stays in
            the search field.

        files:
            Every file in the selected @{ProjectDirectory}, listed as the
            @{ProjectLocations} lists the files under a folder. Picking a
            file opens it, as the @{OpenFile} says. Until a project is
            picked the tab reads "No project open", as the
            @{NoProjectState} says.

        fileSearch:
            On the Files tab, Ctrl+Enter (Cmd+Enter on macOS) sends the search
            to a separate harness run that finds the file being described, even
            when files match. Plain Enter does the same once the file list has
            loaded and nothing matches; otherwise it picks the highlighted file.
            While nothing matches, the results area says so and how to search
            with the harness instead, reading
            "No results. Press Enter to perform an agentic search." in place of
            "No matches".
            While the search runs, the results area shows its
            @{TaskTable}, scrolling with a @{Scrollbar} with no lock
            to the bottom. When it
            finishes, a single file closes the palette and opens that file,
            several files show a "Multiple results were found" alert, and no
            files adds a "No file matching the search was found." row. Changing
            the search or switching tabs stops the run and brings back the
            normal results, and if the palette closes while it runs, nothing
            opens.

        fileSearchSystemPrompt:
            The search's system prompt, file-search.pi, of the
            @{BakedSystemPrompts}, is appended to the harness's own. It
            tells the harness we're really trying to find the one file being
            asked for, giving several only when they are all equally what was
            asked for; to only read and never change anything; and to stop as
            soon as it is confident. It lists where to look, in this order of
            priority, preferring a match from an earlier place over an equally
            good match from a later one: the spec location; the code location;
            `.suspense`; then `.claude`, the locations being those of the
            @{ProjectLocations}. The harness's final reply is only JSON
            listing the files by path relative to the project, and paths that
            don't exist are dropped.

        system:
            The application's own commands, each doing what its toolbar control
            or shortcut does: "New Project…" and "Import Project…", which open
            the @{NewProject} and the @{ImportProject} as the ribbon's
            commands do, "Open Project…", which opens the
            @{OpenProject}, "Build", "Dark mode" or
            "Light mode" (whichever is not the current one), "Planning", which opens the @{Planning}, "Settings…", which
            opens the @{SettingsWindow}, "About Suspense", which opens the
            @{About}, "Collect debug info" and "Open debug log", as the
            @{DebugLog} says, and "Quit". Build builds the spec
            on its own, as the @{SpecBuild} says.

        commands:
            The commands of the @{HarnessCatalog}.

        skills:
            The skills of the @{HarnessCatalog}.

        agents:
            The agents of the @{HarnessCatalog}.

        mentions:
            A command, skill, or agent shows its description when it has one.
            Picking one inserts it into the @{ChatInput} at the cursor as a
            mention, as the @{HarnessCatalog} says, with a space before it
            when the cursor follows other text. Focus then moves to the chat
            input.

    fuzzySearch:
        A result matches when the search's characters all appear in it in order,
        ignoring case, though not necessarily next to each other. The best
        matches come first: runs of consecutive characters, and characters at
        the start of a word or of a file's name, rank higher, then shorter
        results. The matched characters are highlighted. With an empty search,
        files are listed by path, the application's commands in the order above,
        and the harness's by name. At most the 100 best results are listed.

    keyboard:
        Up and Down move the highlight, which starts on the first result, and
        Enter picks the highlighted result. Clicking a result picks it.
