// The prompt for titling a task or question, so its hidden anchor can be
// named after it: the request, then the prompt as typed under its heading.

export anchor PromptTitle:
    request:
        Below is a prompt given to a coding agent. Write a short title for it
        that says what it asks for: two to six words, in title case, with no
        punctuation, quotes, or trailing period. Reply with only the title.
    prompt: Prompt
