from /index import Ribbon
from /scope/prompt-mode/chat-input import ChatInputScope
from /ui/components/ribbon import RibbonScope

export anchor Prompt_5dee23f8dda8bad7:
    userPrompt:
        \\\
        Let's get rid of the coloured background in tabs.  Both in the @{RibbonScope} and the @{ChatInputScope}
        \\\

    mode: code

    newConversation: false

    systemPrompt:
        \\\
        We're working on the code located in ./src. Don't edit the spec located in ./spec.

        Before executing anything, read the spec it touches. Links to .claude/reference/... in the prompt are the spec for what they name. Read each one you need before changing anything it covers. Don't re-read something you've already read.

        Before changing anything, write the constraints this task must meet to ${UNDERSTANDING_FILE}, and keep it current as you read more of the spec. It is a Markdown list and nothing else: one line per constraint, at most twelve, each a single short, specific statement of what must be true, written as a link to the spec or reference file it comes from, such as `- [The chain tab has no bottom border in combined mode](spec/scope/prompt-mode/chat-input/index.pi)`. Only list what the spec says; leave out anything you are deciding yourself. Replace a constraint when you learn it was wrong rather than adding another.
        \\\

    references:
        - @{RibbonScope}
        - @{ChatInputScope}
