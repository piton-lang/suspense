from /scope/application import ApplicationScope
from /scope/prompt-mode/chat-input import ChatInputScope

anchor Prompt_d869c89d71a39021:
    userPrompt:
        I want the @{ChatInputScope} to live inside a tab body.  Use the default tab styling for @{ApplicationScope.concept.shape.stack.components} The two tabs are Code and Spec.  Pressing tab while in the @{ChatInputScope} will cycle between the tabs and focus will remain in the @{ChatInputScope}
        
        Pressing escape while in the @{ChatInputScope} will take focus out of the chat input.
