
export anchor SpecCompilationLocation2:
    userPrompt:
        \\\
        Suspense.  You the containerized agent have the ability to to read both spec and code, correct?  When suspense tries to run a `piton compile` is it using piton from the container or the host ?
        \\\

    mode: ask

    newConversation: false

    systemPrompt:
        \\\
        We're only asking a question about the project. Answer it without changing anything.

        The code is located in ./src.
        \\\
