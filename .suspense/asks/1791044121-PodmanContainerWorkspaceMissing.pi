
export anchor PodmanContainerWorkspaceMissing:
    userPrompt:
        \\\
        I keep getting "The harness couldn't be started in its container. Podman said: Error: workdir "/workspace does not exist on container ID"
        \\\

    mode: ask

    newConversation: false

    systemPrompt:
        \\\
        We're only asking a question about the project. Answer it without changing anything.

        The code is located in ./src.
        \\\
